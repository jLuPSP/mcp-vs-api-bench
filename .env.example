# Copy to .env and fill in. .env is gitignored.

# ---- Model providers -------------------------------------------------------
# DeepSeek (OpenAI-compatible). Primary provider for headline numbers.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Ollama (OpenAI-compatible endpoint). Free, fast iteration.
# Point at any host running Ollama. Do NOT put a real hostname in a committed file.
OLLAMA_URL=http://your-ollama-host:11434/v1
OLLAMA_MODEL=qwen3:14b-16k

# Anthropic. Optional. The only provider with explicit cache-breakpoint control,
# which is what makes the tool-block cache experiment cleanly measurable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium

# ---- Benchmark stack -------------------------------------------------------
BACKEND_URL=http://127.0.0.1:9110
MCP_SIDECAR_URL=http://127.0.0.1:9111/mcp
MCP_REMOTE_URL=http://127.0.0.1:9112/mcp

# Deterministic backend behaviour. Jitter 0 keeps the control term clean.
BENCH_SEED=1729
BACKEND_LATENCY_MS=40
BACKEND_JITTER_MS=0

# 1 = pad records with the fields a real system of record returns (SLA state, custom
# fields, linked records). Set to 1 to reproduce the published three-arm comparison;
# leave 0 to reproduce the latency and schema-token tables.
BENCH_ENTERPRISE=0

# One-way delay injected on the mcp_remote container via tc netem.
# Set to 0 to reproduce the published protocol-overhead table, which has no injected
# delay. The netem sweep varies this deliberately.
NETEM_DELAY=0
