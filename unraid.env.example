# Copy to unraid.env and fill in with real values. unraid.env is gitignored.
# Only needed if you run the optional real-remote arm (see labs/README.md).
# Committed files reference $UNRAID_SSH / $APPDATA / ${UNRAID_HOST}, never the values.

UNRAID_HOST=your-unraid-host.local
UNRAID_IP=10.0.0.0
UNRAID_SSH=root@your-unraid-host.local
APPDATA=/mnt/user/appdata
OLLAMA_URL=http://your-unraid-host:11434/v1
